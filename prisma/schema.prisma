
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int     @id @default(autoincrement())
  username  String
  email     String  @unique
  password  String
}

model Class {
  id      Int @id @default(autoincrement())
  class   String @unique
}
model Student {
  id          Int     @id @default(autoincrement())
  fullname    String
  class       String  
  rollNumber  Int 
  contact     String? 
}