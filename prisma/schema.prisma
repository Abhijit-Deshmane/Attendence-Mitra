
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model USER {
  id        Int     @id @default(autoincrement())
  username  String
  email     String  @unique
  password  String
}

model CLASS {
  id      Int @id @default(autoincrement())
  class   String @unique
}
model STUDENTS {
  id          Int     @id @default(autoincrement())
  fullname    String
  class       String  
  rollNumber  Int 
  contact     Int?
}